{
  "region": "it",
  "crawler": {
    "maxReqsPerMin": 10
  },
  "ollama": {
    "enable": true,
    "__host": "<custom-ollama-base-url>",
    "model": "gemma4:12b",
    "think": true,
    "timeout": 1800
  },
  "filter": {
    "cpu": {
      "enable": true,
      "sort.by": "normCpumark",
      "sort.direction": "desc",
      "limit": 1,
      "year.min": 2022,
      "__year.max": 2099,
      "category": "Desktop",
      "sockets": ["AM5", "FCLGA1851"],
      "cpumark.min": 20000,
      "__cpumark.max": 999999
    },
    "gpu": {
      "enable": true,
      "sort.by": "normG3d",
      "sort.direction": "desc",
      "limit": 1,
      "year.min": 2022,
      "__year.max": 2099,
      "category": "Desktop",
      "vram.min": 15000,
      "__vram.max": 999999,
      "g3d.min": 15000,
      "__g3d.max": 999999
    },
    "ssd": {
      "enable": true,
      "sort.by": "normDiskmark",
      "sort.direction": "desc",
      "limit": 1,
      "year.min": 2022,
      "__year.max": 2099,
      "size.min": 3000,
      "size.max": 5000,
      "diskmark.min": 20000,
      "__diskmark.max": 999999
    },
    "hdd": {
      "enable": true,
      "sort.by": "normSize",
      "sort.direction": "desc",
      "limit": 1,
      "year.min": 2022,
      "__year.max": 2099,
      "size.min": 15000,
      "__size.max": 999999,
      "__diskmark.min": 0,
      "__diskmark.max": 999999
    }
  },
  "out": {
    "dir": "out",
    "json": true,
    "csv": true,
    "txt": true,
    "plot": true
  }
}
